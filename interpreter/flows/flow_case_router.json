{
  "flow_id": "f0f0f0f0-0000-4000-8000-000000000000",
  "tenant_id": "00000000-0000-0000-0000-000000000000",
  "team": "router",
  "name": "Case router \u2014 team routing + tag manager",
  "version": 3,
  "status": "draft",
  "_doc": "Phase 20n/21. identify -> sf_case -> retrieve -> classify -> team_route -> sf_writeback -> case_lookup -> draft -> confidence_gate. case_lookup (Phase 21) recalls similar resolved Cases into prior_resolutions for draft; skipped for answer_mode=action, hints-only for diagnostic. Gate: (enterprise|offboarding) handover ; (pass) auto_reply ; (fail + csm/sales) ask_human ; (fail + support + forced) notify ; (fail + support + not forced) clarify.",
  "nodes": [
    {
      "node_id": "f0000000-0000-4000-8000-000000000001",
      "type": "identify",
      "label": "Resolve the sender",
      "config": {
        "email_field": "contact.email",
        "domain_match": true
      }
    },
    {
      "node_id": "f0000000-0000-4000-8000-000000000002",
      "type": "sf_case",
      "label": "Create / reuse the Salesforce Case",
      "config": {
        "origin": "Web",
        "status": "New",
        "reuse": "thread"
      }
    },
    {
      "node_id": "f0000000-0000-4000-8000-000000000003",
      "type": "retrieve",
      "label": "Retrieve KB context",
      "config": {
        "source": [
          "supabase"
        ],
        "top_k": 5,
        "use_rerank": true
      }
    },
    {
      "node_id": "f0000000-0000-4000-8000-000000000004",
      "type": "classify",
      "label": "Classify tier / type / topic / urgency",
      "config": {
        "tier_field": "account.customer_type",
        "region_field": "account.region",
        "default_tier": "basic"
      }
    },
    {
      "node_id": "f0000000-0000-4000-8000-000000000005",
      "type": "team_route",
      "label": "Route to a team (design-doc rules)",
      "config": {
        "default": "support"
      }
    },
    {
      "node_id": "f0000000-0000-4000-8000-000000000006",
      "type": "sf_writeback",
      "label": "Write triage fields to the Case (Type, Module, Priority\u2026)",
      "config": {}
    },
    {
      "node_id": "f0000000-0000-4000-8000-000000000014",
      "type": "case_lookup",
      "label": "Recall similar resolved Cases (Phase 21)",
      "config": {
        "k": 3,
        "pool": 10,
        "min_similarity": 0.35,
        "min_memories": 3,
        "use_graph": true,
        "skip_modes": [
          "action"
        ]
      }
    },
    {
      "node_id": "f0000000-0000-4000-8000-000000000007",
      "type": "draft",
      "label": "Draft the reply from context",
      "config": {
        "model": "openai/gpt-oss-120b",
        "max_tokens": 700
      }
    },
    {
      "node_id": "f0000000-0000-4000-8000-000000000008",
      "type": "confidence_gate",
      "label": "Tag manager \u2014 score & decide",
      "config": {
        "weights": {
          "retrieval": 0.55,
          "draft": 0.1,
          "groundedness": 0.35
        },
        "default_threshold": 0.5,
        "tier_overrides": {
          "basic": 0.5,
          "premium": 0.6,
          "enterprise": 0.75
        },
        "escalate_topics": [
          "billing",
          "refund",
          "pricing",
          "legal",
          "compliance",
          "account-access",
          "data-export",
          "cancellation",
          "sso",
          "saml",
          "login",
          "locked out",
          "lockout",
          "2fa",
          "mfa",
          "password reset"
        ],
        "escalate_modules": [
          "Billing & Plans",
          "Account & Login"
        ],
        "escalate_types": [
          "Billing",
          "Account / Login"
        ]
      }
    },
    {
      "node_id": "f0000000-0000-4000-8000-000000000009",
      "type": "auto_reply",
      "label": "Auto-reply to the customer",
      "config": {
        "channel": "email"
      }
    },
    {
      "node_id": "f0000000-0000-4000-8000-000000000010",
      "type": "ask_human",
      "label": "Escalate to the owning team (csm / sales) \u2014 reassigns the Case",
      "config": {
        "channel": "salesforce_chatter",
        "queue_by_team": {
          "csm": "Team_CSM",
          "sales": "Team_Sales"
        },
        "escalate_queue": "Billing_Escalations"
      }
    },
    {
      "node_id": "f0000000-0000-4000-8000-000000000011",
      "type": "handover",
      "label": "Full handover (enterprise / offboarding)",
      "config": {
        "reason": "enterprise_or_offboarding",
        "queue_by_team": {
          "offboarding": "Team_Offboarding"
        },
        "enterprise_queue": "Enterprise_Support"
      }
    },
    {
      "node_id": "f0000000-0000-4000-8000-000000000012",
      "type": "notify",
      "label": "Ping the Type's internal rep (Case stays in the queue)",
      "config": {
        "channel": "salesforce_chatter",
        "target_by_type": {},
        "target_by_module": {},
        "fallback_target": null
      }
    },
    {
      "node_id": "f0000000-0000-4000-8000-000000000013",
      "type": "clarify",
      "label": "Ask the customer for missing detail",
      "config": {
        "max_questions": 3,
        "max_rounds": 2,
        "auto_send": false,
        "channel": "email",
        "handover_queue": "Team_Support"
      }
    }
  ],
