{
  "flow_id": "e5e5e5e5-5555-4555-8555-555555555555",
  "tenant_id": "00000000-0000-0000-0000-000000000000",
  "team": "email",
  "name": "Email L0/L1 — inbound to Salesforce",
  "version": 2,
  "status": "draft",
  "_doc": "Phase 20n redesign. identify -> sf_case -> retrieve -> classify -> sf_writeback -> draft -> confidence_gate. classify now also sets Case.Type; sf_writeback writes it on every pass (kept current on each customer-reply re-run). confidence_gate: (enterprise) handover ; (pass) auto_reply ; (fail + forced escalation — Billing / Account-Login type, a billing topic, or the Billing & Plans module) notify — ping the Type's internal rep on the Case WITHOUT reassigning it, the Case stays in its open queue ; (fail + not forced) clarify — ask the customer targeted questions, still in the open queue; after max_rounds it hands the Case to Team_Support. After notify/clarify the Phase 20m resume poller re-engages the bot when the rep or agent leaves a CaseComment.",
  "nodes": [
    {
      "node_id": "identify",
      "type": "identify",
      "label": "Resolve the sender",
      "config": { "email_field": "from", "domain_match": true, "create_lead_if_missing": false }
    },
    {
      "node_id": "sf_case",
      "type": "sf_case",
      "label": "Create / reuse the Salesforce Case",
      "config": { "origin": "Email", "status": "New", "create_contact": true, "create_account": true, "reuse": "thread" }
    },
    {
      "node_id": "retrieve",
      "type": "retrieve",
      "label": "Retrieve KB context",
      "config": { "source": ["supabase"], "top_k": 5, "use_rerank": true }
    },
    {
      "node_id": "classify",
      "type": "classify",
      "label": "Classify tier / type / topic / urgency",
      "config": { "tier_field": "account.customer_type", "region_field": "account.region", "default_tier": "basic" }
    },
    {
      "node_id": "sf_writeback",
      "type": "sf_writeback",
      "label": "Write triage fields to the Case (Type, Module, Priority…)",
      "config": {}
    },
    {
      "node_id": "draft",
      "type": "draft",
      "label": "Draft the reply from context",
      "config": { "model": "openai/gpt-oss-120b", "max_tokens": 700 }
    },
    {
      "node_id": "confidence_gate",
      "type": "confidence_gate",
      "label": "Gate on answer quality",
      "config": {
        "weights": { "retrieval": 0.55, "draft": 0.1, "groundedness": 0.35 },
        "default_threshold": 0.5,
        "tier_overrides": { "basic": 0.5, "premium": 0.6, "enterprise": 0.75 },
        "escalate_topics": ["billing", "refund", "pricing", "legal", "compliance", "account-access", "data-export", "partner-api", "cancellation"],
        "escalate_modules": ["Billing & Plans"],
        "escalate_types": ["Billing", "Account / Login"]
      }
    },
    { "node_id": "auto_reply", "type": "auto_reply", "label": "Send the drafted reply", "config": { "channel": "email" } },
    {
      "node_id": "notify",
      "type": "notify",
      "label": "Ping the Type's internal rep (Case stays in the queue)",
      "config": {
        "channel": "salesforce_chatter",
        "target_by_type": {},
        "target_by_module": {},
        "fallback_target": null
      }
    },
    {
      "node_id": "clarify",
      "type": "clarify",
      "label": "Ask the customer for missing detail",
      "config": { "max_questions": 3, "max_rounds": 2, "auto_send": false, "channel": "email", "handover_queue": "Team_Support" }
    },
    {
      "node_id": "handover",
      "type": "handover",
      "label": "Full handover (enterprise)",
      "config": { "reason": "enterprise_tier", "queue": "Enterprise_Support" }
    }
  ],
  "edges": [
    { "source_node_id": "identify", "target_node_id": "sf_case", "condition": {} },
    { "source_node_id": "sf_case", "target_node_id": "retrieve", "condition": {} },
    { "source_node_id": "retrieve", "target_node_id": "classify", "condition": {} },
    { "source_node_id": "classify", "target_node_id": "sf_writeback", "condition": {} },
    { "source_node_id": "sf_writeback", "target_node_id": "draft", "condition": {} },
    { "source_node_id": "draft", "target_node_id": "confidence_gate", "condition": {} },

    {
      "source_node_id": "confidence_gate",
      "target_node_id": "handover",
      "condition": { "if": "tier == 'enterprise'" }
    },
    {
      "source_node_id": "confidence_gate",
      "target_node_id": "auto_reply",
      "condition": { "if": "confidence_gate.pass and tier != 'enterprise'" }
    },
    {
      "source_node_id": "confidence_gate",
      "target_node_id": "notify",
      "condition": { "if": "not confidence_gate.pass and tier != 'enterprise' and confidence_gate.forced_escalation" }
    },
    {
      "source_node_id": "confidence_gate",
      "target_node_id": "clarify",
      "condition": { "if": "not confidence_gate.pass and tier != 'enterprise' and not confidence_gate.forced_escalation" }
    }
  ]
}
