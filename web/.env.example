# Copy to web/.env.local
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key>
# API base — leave blank to use the Vite dev proxy (/api -> localhost:8000)
VITE_API_BASE=

# Both optional and independent — leave blank and neither loads at all (no
# script, no cookie, nothing). Public marketing site only (landing/login/
# legal pages) — the signed-in product never loads either. See
# src/analytics.ts and src/landing/CookiePolicy.tsx.
VITE_GTM_CONTAINER_ID=
VITE_GA4_MEASUREMENT_ID=

# Error monitoring (optional) — leave blank and nothing loads at all. Unlike
# GTM/GA4 above, this runs everywhere, including once signed in — catching
# a real crash in the product is the whole point. See src/sentry.ts.
VITE_SENTRY_DSN=
