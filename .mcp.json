{
  "mcpServers": {
    "neo4j": {
      "command": "venv/bin/mcp-neo4j-cypher",
      "args": [],
      "env": {
        "NEO4J_URI": "${NEO4J_URI}",
        "NEO4J_USERNAME": "${NEO4J_USERNAME}",
        "NEO4J_PASSWORD": "${NEO4J_PASSWORD}",
        "NEO4J_DATABASE": "neo4j"
      }
    },
    "case-monitor": {
      "command": "venv/bin/python",
      "args": [
        "-m",
        "interpreter.monitor.mcp_server"
      ],
      "env": {}
    }
  }
}
