# Copy to .env and fill in. .env is gitignored.

# --- Supabase (required) ---------------------------------------------------
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key — backend jobs only, bypasses RLS>
SUPABASE_ANON_KEY=<anon/publishable key — safe for client; the api uses it for RLS-scoped calls>

# --- Neo4j Aura (ingestion graph sync; optional) ------------------------------
NEO4J_URI=neo4j+s://<id>.databases.neo4j.io
NEO4J_USERNAME=<id>
NEO4J_PASSWORD=
NEO4J_DATABASE=<id>          # some Aura instances name the DB after the instance id

# --- LLM (optional — a deterministic stub is used when no key is set) -------
GROQ_API_KEY=              # free tier: https://console.groq.com
OPENROUTER_API_KEY=        # free fallback when Groq's daily quota is spent: https://openrouter.ai/keys
ANTHROPIC_API_KEY=         # opt-in, paid: https://console.anthropic.com
# complete() tries the chosen model -> LLM_FALLBACK_MODEL -> Groq default -> stub,
# skipping any provider that rate-limits. Default fallback is an OpenRouter :free model:
# LLM_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_CACHE=1               # in-process memo of classify calls (default on)
# Route everything to one provider without editing flows:
# LLM_DEFAULT_MODEL=claude-sonnet-5
# LLM_FAST_MODEL=claude-haiku-4-5

# --- alerting + human notifications (Phase 23 — optional) -----------------
SLACK_ALERT_WEBHOOK=       # health_check.py alerts here; also the `notify_human` node's
                          # Slack fallback when no tenant bot token / channel is set
# HEALTH_STALE_MIN=15       # a component silent this long = unhealthy
# HEALTH_FAIL_RATE=0.5      # >this share of run_flow jobs failed in the last hour = unhealthy

# --- Salesforce (Phase 3 write-back; optional — dry-run when unset) ---------
# JWT bearer flow (recommended; see docs/SALESFORCE_SETUP.md)
SF_USERNAME=you@example.com
SF_CONSUMER_KEY=
SF_PRIVATE_KEY_FILE=./sf_jwt/server.key
SF_DOMAIN=login             # 'test' for a sandbox, or a My Domain token
# OAuth username-password fallback:
# SF_PASSWORD=
# SF_CONSUMER_SECRET=
# SF_SECURITY_TOKEN=

# Which email intake path is live (SF-1). One of:
#   salesforce_e2c  (default) — Salesforce Email-to-Case opens the Case, CDC
#                    fires `case_created`; the IMAP poller stays OFF.
#   poller          — this app's IMAP poller opens the Case via `sf_case`.
#   both            — run both, relying on cross-path Case dedup (not advised).
# SF_INTAKE_MODE=salesforce_e2c

# --- Google Docs connector (Phase 15; optional — the "Link Google Doc"
#     feature is hidden until these are set; see docs/GOOGLE_SETUP.md) -------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# --- Slack + GitHub for Phase 16 policy actions (optional; see
#     docs/SLACK_SETUP.md). Without them a task_dispatch still records an
#     action_requests row, it just isn't posted / actioned. ----------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/integrations/slack/callback
# Phase 24c — the `slackbot` Socket Mode service. App-level token (scope
# connections:write), from api.slack.com/apps -> your app -> Basic Information
# -> App-Level Tokens. Bot scopes needed: im:history, channels:history,
# groups:history, app_mentions:read, chat:write (+ Event Subscriptions:
# message.channels, message.groups, message.im, app_mention). No-op if unset.
SLACK_APP_TOKEN=
# GitHub: a fine-grained PAT with Issues read/write (or set a per-tenant
# token in tenant_integrations kind='github').
GITHUB_TOKEN=
APPROVAL_TTL_H=24            # pending approvals expire after this many hours

# --- Email channel (Phase 20; per-tenant, configured from the UI) --------
# Nothing platform-side is needed for the IMAP/app-password provider — the
# mailbox creds are entered in the UI and stored in Supabase Vault.
# The Gmail provider reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above;
# register this redirect on that OAuth client and add the gmail.send +
# gmail.readonly scopes (see docs/EMAIL_SETUP.md):
EMAIL_GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/email/google/callback
